#!/usr/bin/env bash
# .githooks/pre-commit
# Fast, targeted pre-commit hook for GraphRAG-DLP.
# Local opt-in only: activate with `git config core.hooksPath .githooks`.
# Does not mutate global Git configurations.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "Running pre-commit quality checks..."

# Identify staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Check for staged Python files
STAGED_PY=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)
if [ -n "$STAGED_PY" ]; then
  echo "Checking syntax of staged Python files..."
  for file in $STAGED_PY; do
    if [ -f "$file" ]; then
      python3 -m py_compile "$file"
    fi
  done
  echo "Python syntax checks passed."
fi

# Check for staged shell scripts
STAGED_SH=$(echo "$STAGED_FILES" | grep -E '\.sh$' || true)
if [ -n "$STAGED_SH" ]; then
  echo "Checking syntax of staged bash scripts..."
  for file in $STAGED_SH; do
    if [ -f "$file" ]; then
      bash -n "$file"
    fi
  done
  echo "Shell script syntax checks passed."
fi

# Check for staged frontend files (ts, tsx, js, jsx, json)
STAGED_FE=$(echo "$STAGED_FILES" | grep -E '^frontend/.*\.(ts|tsx|js|jsx|json)$' || true)
if [ -n "$STAGED_FE" ]; then
  if [ -d "frontend" ] && [ -f "frontend/package.json" ]; then
    if command -v npm >/dev/null 2>&1; then
      if [ -d "frontend/node_modules" ]; then
        echo "Running fast frontend type check..."
        (cd frontend && npx tsc --noEmit)
        echo "Frontend type check passed."
      else
        echo "Note: frontend/node_modules missing; run 'cd frontend && npm ci' for full frontend verification."
      fi
    fi
  fi
fi

# Check for accidental credential leaks / private keys staged (ignoring .githooks itself)
SUSPICIOUS=$(git diff --cached -G"(BEGIN RSA PRIVATE KEY|BEGIN OPENSSH PRIVATE KEY|BEGIN EC PRIVATE KEY|ghp_[A-Za-z0-9]{36})" --name-only | grep -v '^\.githooks/' || true)
if [ -n "$SUSPICIOUS" ]; then
  echo "ERROR: Potential secret or private key detected in staged diff:" >&2
  echo "$SUSPICIOUS" >&2
  exit 1
fi

echo "Pre-commit checks passed successfully."
exit 0
