#!/usr/bin/env bash
# .githooks/pre-commit
# Fast, targeted pre-commit hook for GraphRAG-DLP.
# Local opt-in only: activate with `git config core.hooksPath .githooks`.
# Does not mutate global Git configurations.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "Running pre-commit quality checks..."

PASSED_CHECKS=0
SKIPPED_CHECKS=0

# Identify staged files safely with null delimiters
STAGED_FILES=()
while IFS= read -r -d '' file; do
  [ -n "$file" ] && STAGED_FILES+=("$file")
done < <(git diff --cached --name-only -z --diff-filter=ACM)

if [ ${#STAGED_FILES[@]} -eq 0 ]; then
  echo "No staged files to check."
  exit 0
fi

# Categorize staged files
STAGED_PY=()
STAGED_SH=()
STAGED_FE=()

for f in "${STAGED_FILES[@]}"; do
  if [[ "$f" =~ \.py$ ]]; then
    STAGED_PY+=("$f")
  elif [[ "$f" =~ \.sh$ ]]; then
    STAGED_SH+=("$f")
  elif [[ "$f" =~ ^frontend/.*\.(ts|tsx|js|jsx|json)$ ]]; then
    STAGED_FE+=("$f")
  fi
done

# Python syntax checks
if [ ${#STAGED_PY[@]} -gt 0 ]; then
  echo "Checking syntax of staged Python files..."
  for file in "${STAGED_PY[@]}"; do
    if [ -f "$file" ]; then
      python3 -m py_compile "$file"
    fi
  done
  echo "Python syntax checks: PASS"
  PASSED_CHECKS=$((PASSED_CHECKS + 1))
fi

# Shell script syntax checks
if [ ${#STAGED_SH[@]} -gt 0 ]; then
  echo "Checking syntax of staged bash scripts..."
  for file in "${STAGED_SH[@]}"; do
    if [ -f "$file" ]; then
      bash -n "$file"
    fi
  done
  echo "Shell script syntax checks: PASS"
  PASSED_CHECKS=$((PASSED_CHECKS + 1))
fi

# Frontend checks
if [ ${#STAGED_FE[@]} -gt 0 ]; then
  if [ -d "frontend" ] && [ -f "frontend/package.json" ]; then
    if command -v npm >/dev/null 2>&1; then
      if [ -d "frontend/node_modules" ]; then
        echo "Running fast frontend type check..."
        (cd frontend && npx tsc --noEmit)
        echo "Frontend type check: PASS"
        PASSED_CHECKS=$((PASSED_CHECKS + 1))
      else
        echo "WARNING: frontend/node_modules missing; frontend type check SKIPPED."
        echo "         Actionable: run 'cd frontend && npm ci' to enable staged frontend validation."
        SKIPPED_CHECKS=$((SKIPPED_CHECKS + 1))
      fi
    else
      echo "WARNING: npm not found in PATH; frontend validation SKIPPED."
      SKIPPED_CHECKS=$((SKIPPED_CHECKS + 1))
    fi
  else
    echo "WARNING: frontend package configuration missing; frontend validation SKIPPED."
    SKIPPED_CHECKS=$((SKIPPED_CHECKS + 1))
  fi
fi

# Secret / private key leakage scan (ignoring .githooks itself)
SUSPICIOUS=$(git diff --cached -G"(BEGIN RSA PRIVATE KEY|BEGIN OPENSSH PRIVATE KEY|BEGIN EC PRIVATE KEY|ghp_[A-Za-z0-9]{36})" --name-only | grep -v '^\.githooks/' || true)
if [ -n "$SUSPICIOUS" ]; then
  echo "ERROR: Potential secret or private key detected in staged diff:" >&2
  echo "$SUSPICIOUS" >&2
  exit 1
fi

echo ""
echo "=== Pre-Commit Summary ==="
echo "Checks passed: ${PASSED_CHECKS}"
if [ $SKIPPED_CHECKS -gt 0 ]; then
  echo "Checks skipped: ${SKIPPED_CHECKS} (see warnings above)"
fi
echo "Pre-commit verification finished successfully."
exit 0
