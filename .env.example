# GraphRAG-DLP Environment Configuration
# ========================================================
# Default Mode: Deterministic Local (Zero API Keys Required)
# All ABAC security policies, restricted Cypher transformations,
# and deterministic extractive answers run completely offline.

# --------------------------------------------------------
# Application Server (FastAPI / Uvicorn)
# --------------------------------------------------------
APP_ENV=demo
HOST=127.0.0.1
PORT=8000

# SQLite Persistent Evidence and Graph Store
# A random 32-character hex key is safely generated and persisted with 0600
# permissions at ${DLP_DB_PATH}.key if JWT_SECRET is unset.
DLP_DB_PATH=backend/data/graph.sqlite3

# JWT ABAC Security Configuration
# Leave JWT_SECRET empty for auto-generated safe local persistence.
# In production (APP_ENV=production), set an explicit >=32 char secret or configure HTTPS JWKS.
JWT_SECRET=
JWT_ISSUER=graphrag-dlp-demo
JWT_AUDIENCE=graphrag-dlp
JWT_ALGORITHM=HS256
# Production JWKS settings (required only when APP_ENV=production):
# JWT_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# JWT_ALGORITHM=RS256

# --------------------------------------------------------
# Optional Neo4j Knowledge Graph Adapter (Profile: neo4j)
# --------------------------------------------------------
# To enable, run: docker compose --profile neo4j up -d neo4j
# Note: execute_read routes read intent; production requires a dedicated read-only principal.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag_password_local
NEO4J_DATABASE=neo4j

# Separate write principal for initial schema/graph provisioning & ingest:
# In production, set dedicated credentials with WRITE privileges.
# If absent or failed, ingested documents succeed locally with graph_indexing pending.
NEO4J_WRITE_USER=
NEO4J_WRITE_PASSWORD=

# Test runner gate for Neo4j integration suite:
# NEO4J_TEST_URI=bolt://neo4j:graphrag_password_local@127.0.0.1:7687

# --------------------------------------------------------
# Optional External Providers & Orchestration (Disabled by Default)
# --------------------------------------------------------
# External providers are strictly optional. When absent, the system defaults
# to deterministic local extractive answers and sparse TF-IDF vectors.
# Missing credentials and disabled features are truthfully reported in /api/v1/health.

# Optional LangGraph StateGraph Orchestration (0=disabled, 1=enabled)
# Requires: uv sync --locked --extra providers
DLP_LANGGRAPH=0

# Groq Answer Generation (Answer provider only; never claims semantic vectors)
# GROQ_API_KEY=
# Supported models: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# FlashRank Reranker (Requires pre-provisioned frozen local model directory)
# Provision using: python3 backend/scripts/provision_flashrank.py --cache-dir models/flashrank
# FLASHRANK_MODEL_DIR=models/flashrank

# --------------------------------------------------------
# Frontend Development Proxy (Vite)
# --------------------------------------------------------
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:8000
